# Copy this file to .env and change the values
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SQLite (default, needs nothing installed):
DATABASE_URL=sqlite:///./inventory.db
